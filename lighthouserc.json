{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4322 --ignore-lock",
      "startServerReadyPattern": "localhost:4322",
      "url": [
        "http://localhost:4322/Portfolio/",
        "http://localhost:4322/Portfolio/work/",
        "http://localhost:4322/Portfolio/work/credential-correlation/",
        "http://localhost:4322/Portfolio/work/trip-planner/"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 30720 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 122880 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.02 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }]
          }
        },
        {
          "matchingUrlPattern": "/Portfolio/$",
          "aggregationMethod": "median",
          "assertions": {
            "resource-summary:total:size": ["error", { "maxNumericValue": 512000 }],
            "resource-summary:image:size": ["error", { "maxNumericValue": 307200 }]
          }
        },
        {
          "matchingUrlPattern": "/Portfolio/work/[^/]+/$",
          "aggregationMethod": "median",
          "assertions": {
            "resource-summary:total:size": ["error", { "maxNumericValue": 3145728 }]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
