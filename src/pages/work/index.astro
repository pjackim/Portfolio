---
/**
 * Work (Portfolio.dc.html, Claude Design, Sept 2026): every published project in one
 * WorkShowcase, the featured ones first (by `order`), then the rest newest first: a rotating
 * lead over an index of rows. A capability filter (WorkFilter, interactions spec §4) narrows
 * it; `?capability=<id>` links straight to a filtered view.
 */
import PageHeader from '../../components/PageHeader.astro';
import WorkFilter from '../../components/WorkFilter.astro';
import WorkShowcase from '../../components/WorkShowcase.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getOrdered } from '../../lib/projects';

const projects = await getOrdered();
---

<BaseLayout
  title="All work — Parker Jackim"
  description="Every project by Parker Jackim: security and reverse-engineering research, software, and design and 3D work."
>
  <div class="standalone container">
    <PageHeader index="03" title="Work" intro="Every project in one place, the strongest first." />
    <WorkFilter class="standalone__body" projects={projects} />
    <div class="work__groups" data-filter-list>
      <WorkShowcase id="all" label="Projects" cta="Open project" projects={projects} eager />
    </div>
  </div>
</BaseLayout>

<style>
  .work__groups {
    margin-block-start: clamp(2.5rem, 1.75rem + 3vw, 3.5rem);
  }

  @media (width < 40rem) {
    .work__groups {
      margin-block-start: var(--space-l);
    }
  }
</style>
