---
/**
 * Not found (spec-design-content §2, spec-architecture §6) → `dist/404.html`. GitHub Pages
 * serves it for any missing path under the site, so every URL here is base-absolute
 * (`withBase`; BaseLayout does the same for assets and nav). Not indexed.
 *
 * The only error screen the host serves by itself; the rest are `errors/<code>/`
 * (src/pages/errors/[code].astro). Its "Closest match" is picked in the browser from the site's
 * real pages, listed below as paths relative to the base.
 */
import ErrorScreen from '../components/ErrorScreen.astro';
import { errorDescription, errorScreen, errorTitle } from '../data/errors';
import { site } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProjects } from '../lib/projects';

const screen = errorScreen(404);
const projects = await getProjects();
const suggest = [
  ['work/', 'All work'],
  ['about/', 'About'],
  ['experience/', 'Experience'],
  ['capabilities/', 'Capabilities'],
  ...projects.map((project) => [`work/${project.id}/`, project.data.title] as const),
] as const;
---

<BaseLayout title={errorTitle(screen, site.name)} description={errorDescription(screen)} noindex>
  <ErrorScreen screen={screen} suggest={suggest} />
</BaseLayout>
