---
/**
 * Document shell for every page (spec-design-content §3, §7): head meta + SEO, the blocking
 * theme bootstrap, self-hosted fonts, global styles; skip link, header, main, footer.
 * Pages add head-only tags (e.g. `<link rel="expect">`) through `<slot name="head" />`.
 *
 * Content-Security-Policy (spec-architecture §6): Astro hashes what it bundles and inlines; the
 * hand-inlined elements here — theme bootstrap, page style block, JSON-LD — are hashed into the
 * policy below. Astro writes the policy `<meta>` near the end of the head; the inline elements
 * before it are hashed too, so the same policy would also hold if sent as a header.
 * The page body is rendered first, so every `pageStyle()` rule its components register
 * (src/lib/page-style.ts) is known by the time the head — and the `<style>` holding those
 * rules — is written.
 */
import { Font } from 'astro:assets';
import Seo from '../components/Seo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { cspHash } from '../lib/csp';
import { takePageStyle } from '../lib/page-style';
import type { OgImage } from '../lib/seo';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/prose.css';

interface Props {
  title: string;
  description: string;
  ogImage?: OgImage;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: object | object[];
}

const { title, description, ogImage, ogType, noindex, jsonLd } = Astro.props;

/** Applies a pinned colour scheme before first paint (blocking by design; spec §1a). */
const THEME_BOOTSTRAP = `try {
  const s = localStorage.getItem('scheme');
  if (s === 'light' || s === 'dark') {
    document.documentElement.dataset.scheme = s;
    document.querySelector('meta[name="color-scheme"]').content = s;
  }
} catch {}`;

const main = await Astro.slots.render('default');
const pageCss = takePageStyle(Astro.locals);
// Escape "<" so no string inside the data can close the script element.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;

Astro.csp?.insertScriptHash(cspHash(THEME_BOOTSTRAP));
if (jsonLdText) Astro.csp?.insertScriptHash(cspHash(jsonLdText));
if (pageCss) Astro.csp?.insertStyleHash(cspHash(pageCss));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={THEME_BOOTSTRAP} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0d10" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9fafb" />
    <Seo
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    {pageCss && <style is:inline set:html={pageCss} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <Fragment set:html={main} />
    </main>
    <SiteFooter />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </body>
</html>
