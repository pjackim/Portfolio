---
/**
 * Hero status readouts (spec-design-content §2, §3): a `<dl>` of label/value pairs between
 * hairlines — one row of cells on wide screens, stacked label | value rows on phones.
 * The " · " separators inside values are kept as text, only tinted.
 */
import type { StatusEntry } from '../data/site';

interface Props {
  entries: readonly StatusEntry[];
  class?: string;
}

const { entries, class: className } = Astro.props;
---

<dl class:list={['status-strip', className]}>
  {entries.map(({ label, value }) => (
    <div class="status-strip__cell">
      <dt class="mono-label">{label}</dt>
      <dd>
        {value.split(' · ').map((part, i) => (
          <>
            {i > 0 && <span class="status-strip__sep"> · </span>}
            <span class="status-strip__part">{part}</span>
          </>
        ))}
      </dd>
    </div>
  ))}
</dl>

<style>
  .status-strip {
    display: grid;
    border-block: var(--hairline);
  }

  .status-strip__cell {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-s);
    align-items: baseline;
    padding-block: var(--space-xs);
  }

  .status-strip__cell + .status-strip__cell {
    border-block-start: var(--hairline);
  }

  dd {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* Where a value can't fit on one line (phones; the row of cells below ~1150px), each term
     gets its own line and the separators drop out — never a dangling "·". */
  .status-strip__part {
    display: block;
  }

  .status-strip__sep {
    display: none;
    color: var(--text-subtle);
  }

  /* Values fit one line: terms inline, split by tinted separators. */
  @media (30rem <= width < 56rem), (width >= 72rem) {
    .status-strip__part {
      display: inline;
      white-space: nowrap;
    }

    .status-strip__sep {
      display: inline;
    }
  }

  /* Wide: one row of readout cells split by vertical hairlines; each cell sizes to its value
     and shares the leftover width, so the row always spans the container. */
  @media (width >= 56rem) {
    .status-strip {
      display: flex;
    }

    .status-strip__cell {
      display: flex;
      flex: 1 1 auto;
      flex-direction: column;
      gap: 0.375rem;
      padding-block: var(--space-s);
      padding-inline: var(--space-m);
    }

    .status-strip__cell:first-child {
      padding-inline-start: 0;
    }

    .status-strip__cell + .status-strip__cell {
      border-block-start: 0;
      border-inline-start: var(--hairline);
    }
  }
</style>
