---
/**
 * Hero status readouts (spec-design-content §2, §3): a `<dl>` of label/value pairs between
 * hairlines — `NOW` and `EDU` (the focus areas live in the hero's typed FOCUS line). From 40rem
 * the cells are equal columns split by a vertical hairline, label over value; on phones they
 * stack as label | value rows. The " · " separators inside values are kept as text, only tinted.
 */
import type { StatusEntry } from '../data/site';

interface Props {
  entries: readonly StatusEntry[];
  class?: string;
}

const { entries, class: className } = Astro.props;
---

<dl class:list={['status-strip', className]}>
  {entries.map(({ label, value }) => (
    <div class="status-strip__cell">
      <dt class="mono-label">{label}</dt>
      <dd>
        {value.split(' · ').map((part, i) => (
          <>
            {i > 0 && <span class="status-strip__sep"> · </span>}
            <span class="status-strip__part">{part}</span>
          </>
        ))}
      </dd>
    </div>
  ))}
</dl>

<style>
  .status-strip {
    display: grid;
    border-block: var(--hairline);
  }

  /* Phones: label | value rows, one term per line; the values start on the same column as the
     typed FOCUS line's text above. */
  .status-strip__cell {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: var(--space-s);
    align-items: baseline;
    padding-block: var(--space-xs);
  }

  .status-strip__cell + .status-strip__cell {
    border-block-start: var(--hairline);
  }

  dd {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  /* From 40rem: the readout values at the body size, medium (Portfolio.dc.html). */
  @media (width >= 40rem) {
    dd {
      font-size: 1.0625rem;
      font-weight: 500;
    }
  }

  /* Where a value can't fit on one line, each term gets its own line and the separators drop
     out — never a dangling "·". */
  .status-strip__part {
    display: block;
  }

  .status-strip__sep {
    display: none;
    color: var(--text-subtle);
  }

  /* From 40rem: equal columns split by vertical hairlines, each a label over its value — a
     readout panel whose divider sits on the centre line, however long either value is. */
  @media (width >= 40rem) {
    .status-strip {
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }

    .status-strip__cell {
      grid-template-columns: none;
      gap: 0.5rem;
      padding-block: 1.375rem 1.5rem;
      padding-inline: 1.875rem 0;
    }

    .status-strip__cell:first-child {
      padding-inline: 0 1.5rem;
    }

    .status-strip__cell + .status-strip__cell {
      border-block-start: 0;
      border-inline-start: var(--hairline);
    }
  }

  /* Half the container fits a value on one line: terms inline, split by tinted separators. */
  @media (width >= 56rem) {
    .status-strip__part {
      display: inline;
      white-space: nowrap;
    }

    .status-strip__sep {
      display: inline;
    }
  }
</style>
