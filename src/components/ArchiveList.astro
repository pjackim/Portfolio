---
/**
 * Archive rows (spec-design-content §2, §3) as a dense readout table on hairline rows — see
 * ArchiveRow.
 *
 * - `limit`: show at most this many rows (home: "Earlier work").
 * - `grouped`: one `<section>` per project group (in `GROUPS` order, empty groups skipped),
 *   each labelled by an `h2` on the section rule — for /work/. Items keep their given order.
 * - `filterable` (with `grouped`): the list WorkFilter filters (`data-filter-list`). Each group
 *   and row gets its view-transition names for the filter's reflow as custom properties through
 *   page-style.ts (`--vt-head` / `--vt-list` on a group, `--vt-name: row-<slug>` on a row);
 *   WorkFilter applies them only while a filter change is transitioning.
 */
import type { CollectionEntry } from 'astro:content';
import { GROUP_LABELS, GROUPS } from '../data/taxonomy';
import { pad2 } from '../lib/format';
import { pageStyle } from '../lib/page-style';
import ArchiveRow from './ArchiveRow.astro';
import SectionHeading from './SectionHeading.astro';

interface Props {
  items: readonly CollectionEntry<'projects'>[];
  grouped?: boolean;
  filterable?: boolean;
  limit?: number;
  class?: string;
}

const { items, grouped = false, filterable = false, limit, class: className } = Astro.props;
const rows = limit === undefined ? items : items.slice(0, limit);

const sections = GROUPS.map((group) => ({
  group,
  label: GROUP_LABELS[group],
  items: rows.filter((p) => p.data.group === group),
  style: filterable
    ? pageStyle(Astro.locals, { '--vt-head': `group-${group}`, '--vt-list': `list-${group}` })
    : undefined,
})).filter((s) => s.items.length > 0);
---

{grouped ? (
  <div class:list={['archive-groups', className]} data-filter-list={filterable ? '' : undefined}>
    {sections.map(({ group, label, items: groupItems, style }, i) => (
      <section
        class="archive-group"
        aria-labelledby={`group-${group}-title`}
        data-group={group}
        data-style={style}
      >
        <SectionHeading index={pad2(i + 1)} label={label} id={`group-${group}-title`} />
        <ol class="archive" role="list">
          {groupItems.map((project) => (
            <ArchiveRow project={project} named={filterable} />
          ))}
        </ol>
      </section>
    ))}
  </div>
) : (
  <ol class:list={['archive', className]} role="list">
    {rows.map((project) => (
      <ArchiveRow project={project} />
    ))}
  </ol>
)}

<style>
  .archive-groups {
    display: grid;
    gap: var(--space-2xl);
  }

  /* The column template every row subgrids (see ArchiveRow). The year rail is shared with
     ExperienceList, so both tables' text columns line up. Phones: a fixed 6rem rail holds
     the longest label (11 mono characters, "Spring 2020", ≤ 94px), so titles line up across
     /work/'s groups; a longer label would widen its own list rather than wrap. */
  .archive {
    display: grid;
    grid-template-columns: minmax(6rem, max-content) minmax(0, 1fr);
    column-gap: var(--space-s);
    padding: 0;
    border-block-start: var(--hairline);
    list-style: none;
  }

  @media (width >= 48rem) {
    .archive {
      grid-template-columns: var(--readout-rail, 9rem) minmax(0, 1fr);
      column-gap: var(--space-m);
    }
  }

  @media (width >= 64rem) {
    .archive {
      grid-template-columns: var(--readout-rail, 9rem) 12rem minmax(0, 1fr);
    }
  }
</style>
