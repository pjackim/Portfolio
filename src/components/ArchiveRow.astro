---
/**
 * One ArchiveList row: year · title link · one-liner · stack (max 3). The title link is
 * stretched over the row (one tab stop); hover/focus light the row and tint the title.
 */
import type { CollectionEntry } from 'astro:content';
import { projectDate } from '../lib/format';
import { withBase } from '../lib/url';
import DateText from './DateText.astro';
import TagList from './TagList.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { id, data } = project;
---

<li class="archive-row">
  <p class="archive-row__year mono-label">
    <DateText text={projectDate(project)} />
  </p>
  <h3 class="archive-row__title">
    <a href={withBase(`work/${id}/`)} data-astro-prefetch>
      {data.title}
    </a>
  </h3>
  <p class="archive-row__summary">{data.summary}</p>
  <TagList class="archive-row__tags" tags={data.stack} max={3} label="Stack" />
</li>

<style>
  /* Columns come from the parent list (ArchiveList) through subgrid, so every row shares the
     same year column: phones — year · title, then the one-liner and tags full width;
     tablets — year rail | title, one-liner, tags; desktop — year | title | one-liner + tags. */
  .archive-row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: minmax(6rem, max-content) minmax(0, 1fr);
    grid-template-columns: subgrid;
    row-gap: 0.375rem;
    align-items: baseline;
    padding-block: var(--space-s);
    border-block-end: var(--hairline);
  }

  /* Hover wash, bled slightly past the text edges so hairlines stay on the container grid. */
  .archive-row::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--space-xs));
    background-color: var(--surface);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-standard);
  }

  .archive-row__title {
    font-size: var(--step-0);
    font-weight: 500;
    line-height: 1.4;
  }

  .archive-row__title a {
    color: var(--text);
    text-decoration: none;
  }

  /* Stretched link: the whole row is the target. */
  .archive-row__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .archive-row__summary {
    grid-column: 1 / -1;
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .archive-row :global(.archive-row__tags) {
    grid-column: 1 / -1;
    margin-block-start: 0.25rem;
  }

  @media (width >= 48rem) {
    .archive-row {
      padding-block: 1.125rem;
    }

    .archive-row__summary,
    .archive-row :global(.archive-row__tags) {
      grid-column: 2;
    }
  }

  @media (width >= 64rem) {
    .archive-row__summary,
    .archive-row :global(.archive-row__tags) {
      grid-column: 3;
      max-inline-size: 62ch;
    }
  }

  .archive-row:has(a:focus-visible)::before {
    opacity: 1;
  }

  .archive-row:has(a:focus-visible) .archive-row__title a {
    color: var(--accent);
  }

  @media (hover: hover) {
    .archive-row:hover::before {
      opacity: 1;
    }

    .archive-row:hover .archive-row__title a {
      color: var(--accent);
    }
  }
</style>
