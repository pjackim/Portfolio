---
/**
 * Sticky site header (Portfolio.dc.html, Claude Design, Sept 2026 — `navDesk`/`navMob`). From
 * 40rem it is three columns on the page ground, with no rule under it:
 * - the home link: pj's monogram, plus the wordmark from 73.75rem (the design's `navName`);
 * - centred between, a 4-item nav (About/Experience/Work/Contact, git-log-numbered 01–04) of
 *   equal columns, each a mono label over a 2px track whose fill tracks scroll progress through
 *   its home-page section (`src/scripts/nav-scroll.ts`): grey once passed, accent only on the
 *   section being read, so the accent marks one thing;
 * - `.site-header__end`: Capabilities (from 57.5rem, underlined when current), the Résumé link
 *   and the theme switch.
 * About/Experience/Contact point at the home page's anchors so they work from every page; Work
 * and Capabilities are their own pages.
 *
 * Phones (under 40rem) get the same 4 items as a segmented bar instead: numbered mono labels
 * whose flex grows for the active one (`mflex`), pj's monogram (no wordmark) and the theme
 * switch. Capabilities and the résumé live in the About panel and the sticky CTA bar instead of
 * the header (Portfolio.dc.html's phone nav has no room for a fifth item). Every phone item but
 * Contact goes to its home-page panel (Work too: the Selected work panel, not /work/, per the
 * design's `mGo`); off the home page, Contact opens the contact sheet directly (there's no
 * standalone contact page).
 *
 * The monogram's caret blinks on the first page load of a session only (sessionStorage
 * `caret`); navigations keep the header, so it never re-blinks.
 */
import { site } from '../data/site';
import { withBase } from '../lib/url';
import Monogram from './Monogram.astro';
import ThemeToggle from './ThemeToggle.astro';

const home = withBase('');
const work = withBase('work/');
const capabilities = withBase('capabilities/');
const path = Astro.url.pathname;
const onHome = path === home;
const onWorkIndex = path === work;
const onWorkCase = path.startsWith(work) && !onWorkIndex;
const about = withBase('about/');
const experience = withBase('experience/');

// The 4-item nav (Portfolio.dc.html navItems: about/experience/work/contact, numbered 01–04).
// `aria-current="page"` when the section's own standalone page is current (design's `navFx`:
// `ids.includes(page) ⇒ act = page`), `"true"` for a case-study page (in the Work section but
// not the index) — same active visual, correct semantics. On the home page every item's active
// state instead comes from scroll (nav-scroll.ts): none gets a static `aria-current` there. At the
// top of the page no section is being read (the design's `navAct` is null until one reaches the
// header), so every item is idle; the phone bar then still widens About, in idle colours (CSS).
// `mobileHref` targets the phone panels' own ids (HomeMobilePanels.astro's `-m` suffix — a
// document can't repeat an id, so the phone panels can't reuse the desktop sections' ids).
const navItems: {
  id: 'about' | 'experience' | 'work' | 'contact';
  idx: string;
  label: string;
  href?: string;
  mobileHref?: string;
  current: 'page' | 'true' | undefined;
}[] = [
  {
    id: 'about',
    idx: '01',
    label: 'About',
    href: `${home}#about`,
    mobileHref: `${home}#about-m`,
    current: path === about ? 'page' : undefined,
  },
  {
    id: 'experience',
    idx: '02',
    label: 'Experience',
    href: `${home}#experience`,
    mobileHref: `${home}#experience-m`,
    current: path === experience ? 'page' : undefined,
  },
  {
    id: 'work',
    idx: '03',
    label: 'Work',
    href: work,
    mobileHref: `${home}#work-m`,
    current: onWorkIndex ? 'page' : onWorkCase ? 'true' : undefined,
  },
  {
    id: 'contact',
    idx: '04',
    label: 'Contact',
    href: `${home}#contact`,
    mobileHref: `${home}#contact-m`,
    current: undefined,
  },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={home} aria-label={`${site.name} — home`}>
      <Monogram size={18} />
      <span class="brand__name">{site.name}</span>
    </a>
    <nav class="site-nav" aria-label="Primary">
      <ul role="list">
        {navItems.map(({ id, idx, label, href, current }) => (
          <li>
            <a href={href} aria-current={current} data-nav-id={id}>
              <span class="site-nav__row">
                <span class="site-nav__idx" aria-hidden="true">
                  {idx}
                </span>
                <span class="site-nav__label">{label}</span>
              </span>
              <span class="site-nav__bar" aria-hidden="true">
                <span class="site-nav__fill" data-navfill={id}></span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="site-header__end">
      <a
        class="site-header__caps"
        href={capabilities}
        aria-current={path === capabilities ? 'page' : undefined}
      >
        Capabilities
      </a>
      <a class="site-header__resume" href={withBase(site.resume)}>
        Résumé <span class="site-header__resume-fmt mono-label">PDF</span>
      </a>
      <ThemeToggle />
    </div>

    <a class="phone-brand" href={home} aria-label={`${site.name} — home`}>
      <Monogram size={17} />
    </a>
    <nav class="phone-nav" aria-label="Primary">
      {navItems.map(({ id, idx, label, mobileHref, current }) =>
        id === 'contact' && !onHome ? (
          <button
            type="button"
            class="phone-nav__item"
            data-nav-id={id}
            commandfor="contact-sheet"
            command="show-modal"
          >
            <span class="phone-nav__row">
              <span class="phone-nav__idx" aria-hidden="true">
                {idx}
              </span>
              <span class="phone-nav__label">{label}</span>
            </span>
            <span class="phone-nav__bar" aria-hidden="true">
              <span class="phone-nav__fill" data-navfill={id}></span>
            </span>
          </button>
        ) : (
          <a href={mobileHref} aria-current={current} data-nav-id={id} class="phone-nav__item">
            <span class="phone-nav__row">
              <span class="phone-nav__idx" aria-hidden="true">
                {idx}
              </span>
              <span class="phone-nav__label">{label}</span>
            </span>
            <span class="phone-nav__bar" aria-hidden="true">
              <span class="phone-nav__fill" data-navfill={id}></span>
            </span>
          </a>
        ),
      )}
    </nav>
    <div class="phone-theme">
      <ThemeToggle />
    </div>
  </div>
</header>

<script src="../scripts/nav-scroll.ts"></script>

<script>
  // First page of the session only. Whether it actually blinks is the CSS motion gate's call;
  // the class goes once the 5 s blink window has passed, so switching motion on later never
  // starts it. Import-free on purpose: it stays a tiny inline script, not another request.
  try {
    // Both monograms: the wordmark's (wide screens) and the phone bar's.
    const monograms = document.querySelectorAll('.site-header .monogram');
    if (monograms.length && !sessionStorage.getItem('caret')) {
      sessionStorage.setItem('caret', '1');
      for (const m of monograms) m.classList.add('is-blinking');
      setTimeout(() => {
        for (const m of monograms) m.classList.remove('is-blinking');
      }, 5200);
    }
  } catch {
    // Storage blocked: no blink rather than a blink on every page.
  }
</script>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 10;
    block-size: var(--header-h);
    background-color: var(--bg);
    view-transition-name: site-header;
  }

  /* Phones: one flex row (the segmented bar, below). Items are 44px targets centred in the
     row, so focus rings (3px offset) stay inside the header. */
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    block-size: 100%;
  }

  /* From 40rem: home link | nav | Capabilities, Résumé, theme switch (Portfolio.dc.html
     `navDesk`). The side columns size to their content; the nav is centred in what's left. */
  @media (width >= 40rem) {
    .site-header__inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      column-gap: clamp(1.25rem, 3vw, 2.5rem);
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    color: var(--text);
    text-decoration: none;
  }

  @media (hover: hover) {
    .brand:hover {
      color: var(--text);
    }
  }

  .brand__name {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* The wordmark only once the centred nav can spare its width (the design's `navName`: a
     1180px frame and up); below that the monogram alone is the home link, named by its label. */
  @media (width < 73.75rem) {
    .brand__name {
      display: none;
    }
  }

  .site-header__end {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  /* ── The numbered nav ──
     Four equal columns, centred and at most 41.25rem wide, each as tall as the header: a mono
     label over a 2px track on the header's foot. The whole column is the link. */
  .site-nav {
    align-self: stretch;
    justify-self: center;
    inline-size: 100%;
    max-inline-size: 41.25rem;
  }

  .site-nav ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
    block-size: 100%;
    padding: 0;
    list-style: none;
  }

  .site-nav li {
    display: flex;
    min-inline-size: 0;
  }

  .site-nav a {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.75rem;
    min-inline-size: 0;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color var(--dur-base) var(--ease-standard);
  }

  /* The column fills the header, so a ring outside it would be clipped by the page's top edge
     and run under the content below: draw it inside. */
  .site-nav a:focus-visible {
    outline-offset: -2px;
  }

  .site-nav__row {
    display: flex;
    gap: 0.5625rem;
    min-inline-size: 0;
    white-space: nowrap;
  }

  /* Git-log-style index mark: accent when the link is active, subtle otherwise. */
  .site-nav__idx {
    flex: none;
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
    transition: color var(--dur-base) var(--ease-standard);
  }

  /* A label too long for its column (narrow tablets) ends in an ellipsis; the index stays, and
     the link's accessible name is the whole label either way. */
  .site-nav__label {
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (hover: hover) {
    .site-nav a:hover {
      color: var(--text);
    }
  }

  /* `aria-current` (off the home page) and `.is-active` (nav-scroll.ts, on it) share the same
     active visual. */
  .site-nav a[aria-current],
  .site-nav a.is-active {
    color: var(--text);
  }

  .site-nav a[aria-current] .site-nav__idx,
  .site-nav a.is-active .site-nav__idx {
    color: var(--accent);
  }

  /* Track and fill: the fill scales from 0 (not reached) to 1 (read past, or current) — a
     static jump with no script, a continuous scroll-linked value with it (nav-scroll.ts sets the
     transform). Sections already read stay filled in grey; only the active one is the accent,
     so the accent marks one thing in the header. */
  .site-nav__bar {
    position: relative;
    display: block;
    block-size: 2px;
    background-color: var(--line);
    overflow: hidden;
  }

  .site-nav__fill {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left center;
    background-color: var(--line-ui);
    transition: background-color var(--dur-base) var(--ease-standard);
  }

  .site-nav a[aria-current] .site-nav__fill {
    transform: scaleX(1);
  }

  .site-nav a[aria-current] .site-nav__fill,
  .site-nav a.is-active .site-nav__fill {
    background-color: var(--accent);
  }

  /* Capabilities: a separate link (design's `navCapsDisp`/`capsDeco`), underlined only when
     current — it isn't part of the numbered nav or its scroll-spy. From 57.5rem (the design's
     920px frame), where the nav keeps room for its labels beside it. */
  .site-header__caps {
    display: none;
    align-items: center;
    min-block-size: 2.5rem;
    padding-inline: 0.375rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
    white-space: nowrap;
    text-decoration: none;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .site-header__caps[aria-current] {
    color: var(--text);
    text-decoration-line: underline;
  }

  @media (hover: hover) {
    .site-header__caps:hover {
      color: var(--text);
    }
  }

  @media (width >= 57.5rem) {
    .site-header__caps {
      display: inline-flex;
    }
  }

  /* Résumé quick link, beside the theme switch at every width from 40rem (phones get it in the
     sticky CTA bar and the About panel instead). */
  .site-header__resume {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.5rem;
    padding-inline: 0.875rem;
    border: var(--rule-ui);
    border-radius: var(--radius-s);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .site-header__resume-fmt {
    color: var(--text-subtle);
  }

  @media (hover: hover) {
    .site-header__resume:hover {
      background-color: var(--surface-2);
    }
  }

  /* ── Phones: the segmented nav bar ── */

  .phone-brand,
  .phone-nav,
  .phone-theme {
    display: none;
  }

  @media (width < 40rem) {
    .brand,
    .site-nav,
    .site-header__end {
      display: none;
    }

    /* The bar runs edge to edge rather than in the container: 1rem in on the left, 0.75rem on
       the right (Portfolio.dc.html `navMob`: `padding: 0 12px 0 16px; gap: 14px`). */
    .site-header__inner {
      inline-size: auto;
      margin-inline: 0;
      padding-inline: 1rem 0.75rem;
      gap: 0.875rem;
    }

    .phone-brand {
      display: flex;
      flex: none;
      align-items: center;
      min-inline-size: 2.75rem;
      min-block-size: 2.75rem;
      color: var(--text);
    }

    .phone-nav {
      display: flex;
      flex: 1;
      align-items: stretch;
      gap: 6px;
      min-inline-size: 0;
    }

    .phone-theme {
      display: block;
      flex: none;
    }
  }

  /* The narrowest phones (under 360px): the theme switch keeps its size, so the row gives up
     spacing instead, keeping every nav item a 24px target (WCAG 2.5.8) at 320px. */
  @media (width < 22.5rem) {
    .site-header__inner {
      padding-inline-end: 0.5rem;
      gap: 0.5rem;
    }

    .phone-nav {
      gap: 4px;
    }
  }

  .phone-nav__item {
    flex: 1;
    min-inline-size: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: 0 0 0.75rem;
    border: 0;
    background-color: transparent;
    color: var(--text-muted);
    font: inherit;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }

  .phone-nav__row {
    display: flex;
    gap: 7px;
    min-inline-size: 0;
    overflow: hidden;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .phone-nav__idx {
    flex: none;
    color: var(--text-subtle);
  }

  .phone-nav__label {
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transition: opacity var(--dur-slow) var(--ease-standard);
  }

  .phone-nav__bar {
    position: relative;
    display: block;
    block-size: 2px;
    background-color: var(--line);
    overflow: hidden;
  }

  .phone-nav__fill {
    position: absolute;
    inset: 0;
    transform: scaleX(0);
    transform-origin: left center;
    background-color: var(--line-ui);
  }

  /* The wide item, its label showing: the active one (`.is-active` from nav-scroll.ts on the
     home page, `aria-current` off it) — or, while none is (the top of the home page, before the
     script runs, a page outside the four sections), About, still in idle colours. The design's
     `mflex`/`lo`: `on || (!navAct && i === 0)`, with its colours from `on` alone. */
  .phone-nav__item.is-active,
  .phone-nav__item[aria-current],
  .phone-nav:not(:has(.is-active, [aria-current])) > .phone-nav__item:first-child {
    flex: 3.4;
  }

  .phone-nav__item.is-active .phone-nav__label,
  .phone-nav__item[aria-current] .phone-nav__label,
  .phone-nav:not(:has(.is-active, [aria-current]))
    > .phone-nav__item:first-child
    .phone-nav__label {
    opacity: 1;
  }

  .phone-nav__item.is-active,
  .phone-nav__item[aria-current] {
    color: var(--text);
  }

  .phone-nav__item.is-active .phone-nav__idx,
  .phone-nav__item[aria-current] .phone-nav__idx {
    color: var(--accent);
  }

  .phone-nav__item.is-active .phone-nav__fill,
  .phone-nav__item[aria-current] .phone-nav__fill {
    background-color: var(--accent);
  }

  .phone-nav__item[aria-current] .phone-nav__fill {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='off'])) .phone-nav__item {
      transition: flex 380ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
</style>
