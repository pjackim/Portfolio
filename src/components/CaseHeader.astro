---
/**
 * Project header (spec-design-content §2, §3): mono eyebrow ("PROJECT 01 · SECURITY &
 * SYSTEMS" or "ARCHIVE · DESIGN & 3D"), the page's h1 at step-4, and the TL;DR: the bottom line
 * up front, one to four plain sentences, so the page opens with what the project is.
 */
interface Props {
  /** First eyebrow part, shown in the accent: "Project 01" or "Archive". */
  kind: string;
  /** Second eyebrow part: the group label. */
  group: string;
  title: string;
  /** The project's `tldr` frontmatter. */
  tldr: string;
  class?: string;
}

const { kind, group, title, tldr, class: className } = Astro.props;
---

<div class:list={['case-header', className]}>
  <p class="case-header__eyebrow mono-label">
    <span class="case-header__kind">{kind}</span>
    <span class="case-header__sep" aria-hidden="true">
      ·
    </span>
    <span class="visually-hidden">, </span>
    <span>{group}</span>
  </p>
  <h1 class="case-header__title">{title}</h1>
  <section class="case-header__tldr" aria-labelledby="tldr-title">
    <h2 class="case-header__tldr-label mono-label" id="tldr-title">
      TL;DR
    </h2>
    <p class="case-header__tldr-text">{tldr}</p>
  </section>
</div>

<style>
  .case-header__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.625em;
  }

  .case-header__kind {
    color: var(--accent);
  }

  .case-header__title {
    max-inline-size: 22ch;
    margin-block-start: var(--space-s);
    font-size: var(--step-4);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  /* A hairline and a mono label, as the page's other blocks (Key points, Figures); the text is
     full-strength, not muted: it is the one thing a visitor who reads nothing else should read. */
  .case-header__tldr {
    max-inline-size: 60ch;
    margin-block-start: var(--space-m);
    padding-block-start: var(--space-xs);
    border-block-start: var(--hairline);
  }

  .case-header__tldr-text {
    margin-block-start: var(--space-2xs);
    color: var(--text);
    font-size: var(--step-1);
    line-height: 1.55;
    text-wrap: pretty;
  }
</style>
