---
/**
 * Inline arrow icon, sized to the surrounding text (1em box, stroke scales with it).
 * Use it instead of → ← ↗ glyphs: the self-hosted Latin subsets of Geist / Geist Mono do
 * not contain them (only ↑ ↓), so glyph arrows would fall back to a platform font.
 * Always decorative (`aria-hidden`): the link text must make sense without it.
 * Hover nudges (`translate: 2px`) hook onto the `.arrow` class.
 */
interface Props {
  dir?: 'right' | 'left' | 'up' | 'down' | 'up-right';
  class?: string;
}

const { dir = 'right', class: className } = Astro.props;
const rotation = { right: 0, down: 90, left: 180, up: 270, 'up-right': -45 }[dir];
---

<svg
  class:list={['arrow', `arrow--${dir}`, className]}
  viewBox="0 0 16 16"
  width="16"
  height="16"
  aria-hidden="true"
  focusable="false"
>
  <g transform={rotation ? `rotate(${rotation} 8 8)` : undefined}>
    <path d="M2.5 8h10.5M8.75 3.75 13 8l-4.25 4.25"></path>
  </g>
</svg>

<style>
  .arrow {
    display: inline-block;
    inline-size: 1em;
    block-size: 1em;
    vertical-align: -0.14em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: square;
    stroke-linejoin: miter;
    overflow: visible;
  }

  .arrow--up-right {
    inline-size: 0.875em;
    block-size: 0.875em;
    vertical-align: -0.08em;
  }
</style>
