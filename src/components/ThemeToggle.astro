---
/**
 * Two-state theme switch (spec-design-content §2; the pill from Portfolio.dc.html, Claude Design,
 * Sept 2026): sun on the left, moon on the right, and a round knob that sits on the scheme in
 * use, whose icon is lit. Rendered `hidden`: it only appears once `src/scripts/theme.ts` runs, so
 * without JS the page simply follows the system scheme. The slot reserves the button's box while
 * scripting is enabled, so revealing it never shifts the header, and is dropped when scripting is
 * off.
 *
 * State comes from `data-next` (the scheme a press switches *to*, set by theme.ts): `light` means
 * dark is in use, so the knob sits right. The accessible name names that next scheme ("Switch to
 * light theme"), so there is no `aria-pressed`: a label that changes with the state and a pressed
 * state would say it twice.
 */
---

<span class="theme-toggle-slot">
  <button type="button" class="theme-toggle" data-theme-toggle hidden aria-label="Switch theme">
    <span class="theme-toggle__track" aria-hidden="true">
      <span class="theme-toggle__knob"></span>
      <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
      </svg>
      <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24">
        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"></path>
      </svg>
    </span>
  </button>
</span>

<script src="../scripts/theme.ts"></script>

<style>
  .theme-toggle-slot {
    /* The pill (58×30) plus 2px each side; the button is a full 44px tall tap target. */
    --track-w: 3.625rem;
    --track-h: 1.875rem;
    --knob: 1.5rem;
    --knob-inset: 2px;
    display: grid;
    place-items: center;
    flex: none;
  }

  @media (scripting: enabled) {
    .theme-toggle-slot {
      min-inline-size: calc(var(--track-w) + 4px);
      min-block-size: 2.75rem;
    }
  }

  /* No JS, no button: drop the empty slot too, so it doesn't add a flex gap at the header's
     end and the nav stays flush with the container edge. */
  @media (scripting: none) {
    .theme-toggle-slot {
      display: none;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    block-size: 2.75rem;
    padding: 0 2px;
    border: 0;
    background-color: transparent;
    color: var(--text-subtle);
  }

  .theme-toggle[hidden] {
    display: none;
  }

  .theme-toggle__track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: var(--track-w);
    block-size: var(--track-h);
    padding-inline: 0.4375rem;
    border: var(--rule-ui);
    border-radius: calc(var(--track-h) / 2);
    background-color: var(--surface);
    transition: border-color var(--dur-fast) var(--ease-standard);
  }

  @media (hover: hover) {
    .theme-toggle:hover .theme-toggle__track {
      border-color: var(--text-subtle);
    }
  }

  /* Centred under whichever icon is lit: the icons sit 7px in from each end, the knob 2px, and
     the travel is the track's inner width less one knob. */
  .theme-toggle__knob {
    position: absolute;
    inset-block-start: calc((var(--track-h) - 2px - var(--knob)) / 2);
    inset-inline-start: var(--knob-inset);
    inline-size: var(--knob);
    block-size: var(--knob);
    border: var(--rule-ui);
    border-radius: 50%;
    background-color: var(--surface-2);
    box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
  }

  .theme-toggle[data-next='light'] .theme-toggle__knob {
    translate: calc(var(--track-w) - 2px - 2 * var(--knob-inset) - var(--knob)) 0;
  }

  /* Painted after the knob, so an icon sits on top of it. */
  .theme-toggle__icon {
    position: relative;
    inline-size: 0.875rem;
    block-size: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: color 200ms var(--ease-standard);
  }

  .theme-toggle[data-next='dark'] .theme-toggle__icon--sun,
  .theme-toggle[data-next='light'] .theme-toggle__icon--moon {
    color: var(--text);
  }

  /* The slide is spatial motion: only while motion is allowed. (During a theme switch's scan
     sweep, global.css gives the knob its own view-transition capture instead.) */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='off'])) .theme-toggle__knob {
      transition: translate 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }
  }
</style>
