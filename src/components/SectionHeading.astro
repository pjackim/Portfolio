---
/**
 * Section heading on the hairline (spec-design-content §2 wireframe):
 *   01 / SELECTED WORK ──────────────────────────────────── All work →
 * The mono index is decorative (`aria-hidden`); the `<h2 id>` is what the section's
 * `aria-labelledby` points at. The action's trailing arrow is drawn by the component — a
 * trailing → in `action.text` is dropped (the Latin Geist subset has no → glyph).
 *
 * Entering view (interactions spec §3, all behind the motion gate): the hairline draws left to
 * right on a scroll timeline (CSS only), and — the first time — the index counts up from 00 and
 * the label decrypts (src/scripts/interactions.ts). The decrypt plays on an `aria-hidden` layer
 * laid over the h2, so the heading's text and accessible name never change.
 */
import Arrow from './Arrow.astro';
import MotionLayer from './MotionLayer.astro';

interface Props {
  /** Zero-padded section number, e.g. "01". */
  index: string;
  label: string;
  /** id of the `<h2>`; the parent section uses it for `aria-labelledby`. */
  id: string;
  /** Internal link on the right of the rule; hover-prefetched (Ruling R24). */
  action?: { href: string; text: string };
  class?: string;
}

const { index, label, id, action, class: className } = Astro.props;
const actionText = action?.text.replace(/\s*→\s*$/u, '');
---

<div class:list={['section-heading', className]} data-section-heading>
  <div class="section-heading__label">
    <span class="section-heading__index" aria-hidden="true">
      <span data-count>{index}</span>
      <span class="section-heading__slash">/</span>
    </span>
    <h2 class="section-heading__title" id={id}>
      {label}
    </h2>
  </div>
  <span class="section-heading__rule" aria-hidden="true"></span>
  {action && (
    <a class="section-heading__action" href={action.href} data-astro-prefetch>
      {actionText}
      <Arrow />
    </a>
  )}
</div>
<MotionLayer />

<style>
  .section-heading {
    display: flex;
    align-items: baseline;
    gap: var(--space-s);
    margin-block-end: var(--space-xl);
    font-family: var(--font-mono);
    line-height: 1.2;
  }

  .section-heading__label {
    display: flex;
    align-items: baseline;
    gap: 0.625em;
    min-inline-size: 0;
    font-size: var(--step-0);
  }

  .section-heading__index,
  .section-heading__title {
    font-size: var(--step-0);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .section-heading__index {
    flex: none;
    color: var(--accent);
  }

  .section-heading__slash {
    color: var(--text-subtle);
  }

  .section-heading__title {
    position: relative;
    min-inline-size: 0;
    color: var(--text);
    text-wrap: balance;
  }

  /* Decrypting (src/scripts/interactions.ts): the h2's own glyphs go transparent under an
     aria-hidden layer on exactly the same box, so the scrambled line wraps exactly like the
     real one and nothing moves. */
  .section-heading__title[data-decrypt] {
    color: transparent;
  }

  .section-heading__title :global(.section-heading__decrypt) {
    position: absolute;
    inset: 0;
    color: var(--text);
  }

  /* The hairline runs from the label to the action (or to the container edge). */
  .section-heading__rule {
    flex: 1 1 var(--space-l);
    align-self: center;
    min-inline-size: var(--space-l);
    block-size: 1px;
    background-color: var(--line);
  }

  .section-heading__action {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375em;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0;
    text-decoration: none;
    white-space: nowrap;
  }

  /* Phones: a smaller label, so "01 / SELECTED WORK ── All work →" still fits one line. */
  @media (width < 30rem) {
    .section-heading__label,
    .section-heading__index,
    .section-heading__title {
      font-size: 0.875rem;
    }

    .section-heading {
      gap: var(--space-xs);
    }
  }

  /* Motion (the gate, global.css). */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='off'])) .section-heading__action :global(.arrow) {
      transition: translate var(--dur-base) var(--ease-out);
    }

    @media (hover: hover) {
      :global(:root:not([data-motion='off'])) .section-heading__action:hover :global(.arrow) {
        translate: 2px 0;
      }
    }

    /* The rule draws from the label outward while it rises through the bottom third of the
       viewport — scrubbed by scroll, so it is always fully drawn by the time it's read. Longhands
       only (Ruling R22). */
    @supports ((animation-timeline: view()) and (animation-range: entry)) {
      @keyframes section-rule-draw {
        from {
          scale: 0 1;
        }
      }

      :global(:root:not([data-motion='off'])) .section-heading__rule {
        transform-origin: 0 50%;
        animation-name: section-rule-draw;
        animation-timing-function: var(--ease-out);
        animation-fill-mode: backwards;
        animation-timeline: view();
        animation-range: cover 0% cover 32%;
      }
    }
  }
</style>
