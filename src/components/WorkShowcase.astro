---
/**
 * One section of /work/ (Portfolio.dc.html, Claude Design, Sept 2026 — "1a, featured lead + index
 * list"): a lead panel showing one project large (cover, summary, stack, the way in), tick marks
 * to pick which, and the section's index below — every project a row, the whole row a link.
 *
 * The lead moves on by itself every 6 seconds while motion is allowed: the current tick fills as
 * a progress bar (a CSS animation, so hovering or focusing the section pauses it for free), and
 * src/scripts/work-showcase.ts steps on when it ends. The status readout ("AUTO · 01 / 06") is the
 * pause button. With motion off nothing moves on its own and the current tick is simply full.
 * Rows mark the project in the lead; on a mouse, hovering a row floats its cover beside the
 * pointer. Phones show the covers as thumbnails in the rows instead.
 *
 * The capability filter (WorkFilter) hides rows and ticks through their `data-capabilities`
 * (pure CSS); the script keeps the lead, the count and the empty state in step with it.
 * Without JS the first project stays in the lead and the controls are not shown.
 */
import { Picture } from 'astro:assets';
import { GROUP_LABELS } from '../data/taxonomy';
import { pad2 } from '../lib/format';
import { adaptive, scalableSizes } from '../lib/images';
import { pageStyle } from '../lib/page-style';
import type { Project } from '../lib/projects';
import { withBase } from '../lib/url';
import Arrow from './Arrow.astro';
import MotionLayer from './MotionLayer.astro';
import TagList from './TagList.astro';

interface Props {
  /** Id prefix, unique on the page. */
  id: string;
  label: string;
  /** The lead's call to action ("Open project"). */
  cta: string;
  projects: readonly Project[];
  /** Number of the first project (rows continue the numbering across sections). */
  start?: number;
  /** The first lead cover is the page's priority image (eager, high priority; above the fold). */
  eager?: boolean;
  class?: string;
}

const { id, label, cta, projects, start = 1, eager = false, class: className } = Astro.props;
const items = projects.map((p, i) => ({
  p,
  n: pad2(start + i),
  href: withBase(`work/${p.id}/`),
  caps: p.data.capabilities.join(' '),
  group: GROUP_LABELS[p.data.group],
  row: pageStyle(Astro.locals, { '--vt-name': `row-${p.id}` }),
}));
---

<section
  class:list={['showcase', className]}
  aria-labelledby={`${id}-title`}
  data-showcase
  data-filter-group
>
  <div class="showcase__head">
    <h2 class="showcase__title" id={`${id}-title`}>
      {label}
    </h2>
    <span class="showcase__count" data-showcase-count>
      {pad2(items.length)}
    </span>
    <span class="showcase__rule" aria-hidden="true"></span>
    {items.length > 1 && (
      <button type="button" class="showcase__status" data-showcase-toggle aria-pressed="false">
        <span class="visually-hidden">Pause, </span>
        <span class="showcase__auto">
          <span class="showcase__running">Auto</span>
          <span class="showcase__paused">Paused</span> ·
        </span>
        <span data-showcase-pos>01 / {pad2(items.length)}</span>
      </button>
    )}
  </div>

  <div class="showcase__leads">
    {items.map(({ p, n, href, group }, i) => (
      <article
        class="lead"
        data-lead={p.id}
        data-capabilities={p.data.capabilities.join(' ')}
        hidden={i > 0}
        aria-labelledby={`${id}-lead-${p.id}`}
      >
        <a class="lead__media" href={href} tabindex="-1" aria-hidden="true">
          <Picture
            src={p.data.cover}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[480, 800, 1200, 1600, 2000]}
            sizes={scalableSizes(
              '(min-width: 1760px) 45rem, (min-width: 1216px) 40rem, (min-width: 960px) 56vw, 100vw',
            )}
            alt=""
            class="lead__img"
            {...adaptive(eager && i === 0 ? 'priority' : 'auto')}
          />
          <span class="lead__corner lead__corner--tl"></span>
          <span class="lead__corner lead__corner--br"></span>
        </a>
        <div class="lead__body">
          <p class="lead__meta mono-label">
            <span class="lead__index">{n}</span>
            <span aria-hidden="true">—</span>
            <span class="visually-hidden">, </span>
            {p.data.year}
            <span aria-hidden="true">·</span>
            <span class="visually-hidden">, </span>
            {group}
          </p>
          <h3 class="lead__title" id={`${id}-lead-${p.id}`}>
            {p.data.title}
          </h3>
          <p class="lead__summary">{p.data.summary}</p>
          <TagList class="lead__tags" tags={p.data.stack} max={4} label="Stack" />
          <div class="lead__foot">
            <a class="button button--primary lead__cta" href={href} data-astro-prefetch>
              {cta}
              <Arrow />
              <span class="visually-hidden">: {p.data.title}</span>
            </a>
            {items.length > 1 && (
              <span class="lead__ticks" role="group" aria-label="Show a project in the lead">
                {items.map((t) => (
                  <button
                    type="button"
                    class="tick"
                    data-tick={t.p.id}
                    data-capabilities={t.caps}
                    aria-pressed={t.p.id === p.id ? 'true' : 'false'}
                  >
                    <span class="tick__bar" aria-hidden="true"></span>
                    <span class="visually-hidden">{t.p.data.title}</span>
                  </button>
                ))}
              </span>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  <ol class="showcase__list" role="list" data-showcase-list>
    {items.map(({ p, n, href, group, caps, row }, i) => (
      <li
        class="work-row"
        data-filter-row
        data-capabilities={caps}
        data-project={p.id}
        data-on={i === 0 || undefined}
        data-style={row}
      >
        <a class="work-row__link" href={href} data-astro-prefetch>
          <span class="work-row__index" aria-hidden="true">
            {n}
          </span>
          <span class="work-row__main">
            <span class="work-row__title">{p.data.title}</span>
            <span class="work-row__meta mono-label">
              <span class="visually-hidden">, </span>
              {p.data.year} <span aria-hidden="true">·</span>
              <span class="visually-hidden">, </span>
              {group}
            </span>
          </span>
          <span class="work-row__group mono-label" aria-hidden="true">
            {group}
          </span>
          <span class="work-row__year mono-label" aria-hidden="true">
            {p.data.year}
          </span>
          <span class="work-row__arrow" aria-hidden="true">
            <Arrow />
          </span>
        </a>
        <Picture
          src={p.data.cover}
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[160, 320, 520]}
          sizes={scalableSizes('(min-width: 640px) 260px, 64px')}
          alt=""
          class="work-row__thumb"
          {...adaptive('lite')}
        />
      </li>
    ))}
  </ol>
  <p class="showcase__empty mono-label">No projects tagged with this capability</p>
</section>
<MotionLayer />

<style>
  .showcase ~ :global(.showcase) {
    margin-block-start: clamp(3rem, 2rem + 3vw, 3.5rem);
  }

  /* FEATURED 06 ──────────────────── AUTO · 01 / 06 */
  .showcase__head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .showcase__title {
    font-size: inherit;
    font-weight: inherit;
  }

  .showcase__count {
    color: var(--text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .showcase__rule {
    flex: 1;
    block-size: 1px;
    background-color: var(--line);
  }

  .showcase__status {
    min-block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-subtle);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) {
    .showcase__status:hover {
      color: var(--text);
    }
  }

  .showcase__paused,
  .showcase[data-paused] .showcase__running {
    display: none;
  }

  .showcase[data-paused] .showcase__paused {
    display: inline;
  }

  /* Only while it moves on by itself does it say so, or pause. */
  :global(:root[data-motion='off']) .showcase__auto {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .showcase__auto {
      display: none;
    }
  }

  @media (scripting: none) {
    .showcase__status,
    .lead__ticks {
      display: none;
    }
  }

  /* ── The lead: cover left, text right ── */

  .showcase__leads {
    margin-block-start: 1.375rem;
  }

  .lead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 2.75rem;
    align-items: center;
  }

  .lead[hidden] {
    display: none;
  }

  .lead__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    border: var(--hairline);
    border-radius: var(--radius-s);
    background-color: var(--surface-2);
  }

  .lead__media :global(picture) {
    display: contents;
  }

  .lead :global(.lead__img) {
    inline-size: 100%;
    block-size: 100%;
    border-radius: calc(var(--radius-s) - 1px);
    object-fit: cover;
    object-position: top center;
  }

  .lead__corner {
    position: absolute;
    inline-size: 14px;
    block-size: 14px;
    border: 0 solid var(--accent);
  }

  .lead__corner--tl {
    inset-block-start: -6px;
    inset-inline-start: -6px;
    border-block-start-width: 1.5px;
    border-inline-start-width: 1.5px;
  }

  .lead__corner--br {
    inset-block-end: -6px;
    inset-inline-end: -6px;
    border-block-end-width: 1.5px;
    border-inline-end-width: 1.5px;
  }

  .lead__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-inline-size: 0;
  }

  .lead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.5em;
    font-size: 0.875rem;
  }

  .lead__index {
    color: var(--accent);
  }

  .lead__title {
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .lead__summary {
    color: var(--text-muted);
    font-size: var(--step-0);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .lead__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    margin-block-start: 0.5rem;
  }

  /* One tick per project, so a long list wraps onto a second row instead of overflowing. */
  .lead__ticks {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 6px;
    max-inline-size: 100%;
  }

  .tick {
    position: relative;
    inline-size: 1.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
  }

  /* The track, and over it the fill: full on the current tick, animated while it runs. */
  .tick::before,
  .tick__bar {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(50% - 1px);
    block-size: 2px;
  }

  .tick::before {
    content: '';
    background-color: var(--line-ui);
  }

  .tick__bar {
    background-color: var(--accent);
    transform-origin: left center;
    scale: 0 1;
  }

  .tick[aria-pressed='true'] .tick__bar {
    scale: 1 1;
  }

  @media (hover: hover) {
    .tick:hover::before {
      background-color: var(--text-muted);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes tick-fill {
      from {
        scale: 0 1;
      }

      to {
        scale: 1 1;
      }
    }

    :global(:root:not([data-motion='off']))
      .showcase[data-auto]
      .tick[aria-pressed='true']
      .tick__bar {
      animation: tick-fill 6s linear both;
    }

    /* Paused while the pointer or focus is in the section, it's off screen, or it was paused. */
    :global(:root:not([data-motion='off']))
      .showcase[data-auto]:is(:hover, :focus-within, [data-paused], [data-offscreen])
      .tick[aria-pressed='true']
      .tick__bar {
      animation-play-state: paused;
    }

    @keyframes lead-in {
      from {
        opacity: 0;
        translate: 0 8px;
      }
    }

    /* A lead the rotation or a tick brought in (not the first one, which is just there). */
    :global(:root:not([data-motion='off'])) .lead[data-enter] {
      animation: lead-in 420ms var(--ease-out);
    }
  }

  /* ── The index ── */

  .showcase__list {
    position: relative;
    margin-block-start: 2rem;
    padding: 0;
    border-block-end: var(--hairline);
    list-style: none;
  }

  .work-row__link {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 10rem 6rem 2rem;
    gap: 0.25rem 1.25rem;
    align-items: center;
    min-block-size: 4rem;
    padding-block: 0.75rem;
    border-block-start: var(--hairline);
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  /* The project in the lead: an accent bar at the row's start, its number and title lit. */
  .work-row__link::before {
    content: '';
    position: absolute;
    inset-block: 1rem;
    inset-inline-start: -0.875rem;
    inline-size: 2px;
    background-color: var(--accent);
    opacity: 0;
  }

  .work-row[data-on] .work-row__link {
    color: var(--text);
  }

  .work-row[data-on] .work-row__link::before {
    opacity: 1;
  }

  .work-row__index {
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .work-row[data-on] .work-row__index {
    color: var(--accent);
  }

  .work-row__main {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-inline-size: 0;
  }

  .work-row__title {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .work-row__meta {
    display: none;
  }

  .work-row__year {
    text-align: end;
  }

  .work-row__arrow {
    justify-self: end;
    color: var(--text-subtle);
  }

  .work-row__link:focus-visible,
  .work-row__link:focus-visible .work-row__arrow {
    color: var(--accent);
  }

  @media (hover: hover) {
    .work-row__link:hover,
    .work-row__link:hover .work-row__arrow {
      color: var(--accent);
    }
  }

  /* The cover preview: floats beside the pointer (--px/--py, set on the list by the script,
     which keeps it inside the list's width so it never widens the page) while a row is hovered.
     Decorative: the row's link names the project. */
  .showcase :global(.work-row__thumb) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    z-index: 4;
    inline-size: 16.25rem;
    aspect-ratio: 16 / 10;
    border: var(--rule-ui);
    border-radius: var(--radius-xs);
    background-color: var(--surface-2);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
    object-fit: cover;
    object-position: top center;
    opacity: 0;
    pointer-events: none;
    translate: var(--px, 0) var(--py, 0);
  }

  @media (hover: hover) and (width >= 40rem) {
    .work-row:has(.work-row__link:hover) :global(.work-row__thumb) {
      opacity: 1;
    }
  }

  @media (hover: none) and (width >= 40rem) {
    .showcase :global(.work-row__thumb) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='off'])) .showcase :global(.work-row__thumb) {
      transition:
        opacity 160ms var(--ease-standard),
        translate 140ms var(--ease-out);
    }

    :global(:root:not([data-motion='off'])) .work-row__main,
    :global(:root:not([data-motion='off'])) .work-row__arrow {
      transition: translate 280ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    @media (hover: hover) {
      :global(:root:not([data-motion='off'])) .work-row__link:hover .work-row__main {
        translate: 6px 0;
      }

      :global(:root:not([data-motion='off'])) .work-row__link:hover .work-row__arrow {
        translate: 3px 0;
      }
    }
  }

  .showcase__empty {
    display: none;
    padding-block: 1.375rem;
    border-block-start: var(--hairline);
  }

  .showcase[data-empty] :is(.showcase__leads, .showcase__status, .showcase__list) {
    display: none;
  }

  .showcase[data-empty] .showcase__empty {
    display: block;
  }

  /* Tablets: the lead stacks, cover above text. */
  @media (width < 60rem) {
    .lead {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.375rem;
    }

    .work-row__link {
      grid-template-columns: 2.5rem minmax(0, 1fr) 4rem 1.5rem;
    }

    .work-row__group {
      display: none;
    }
  }

  /* ── Phones: a lead card, then rows with thumbnails ── */
  @media (width < 40rem) {
    /* Sticks under the header while its section scrolls by, so the group (and the running
       lead's status) stays legible without eating space once past it (Portfolio.dc.html:
       `wgHdPos` = 'sticky' on mobile). */
    .showcase__head {
      position: sticky;
      inset-block-start: var(--header-h);
      z-index: 6;
      padding-block: 0.875rem;
      background-color: var(--bg);
      font-size: 0.75rem;
    }

    .showcase__leads {
      margin-block-start: 1rem;
    }

    .lead {
      gap: 0;
      overflow: hidden;
      border: var(--hairline);
      border-radius: 0.75rem;
      background-color: var(--surface);
    }

    .lead__media {
      border: 0;
      border-block-end: var(--hairline);
      border-radius: 0;
    }

    .lead :global(.lead__img) {
      border-radius: 0;
    }

    .lead__corner,
    .lead :global(.lead__tags) {
      display: none;
    }

    .lead__body {
      gap: 0.375rem;
      padding: 1rem 1rem 0.5rem;
    }

    .lead__meta {
      font-size: 0.71875rem;
    }

    .lead__title {
      font-size: 1.25rem;
      line-height: 1.3;
    }

    .lead__summary {
      display: -webkit-box;
      overflow: hidden;
      font-size: 0.90625rem;
      line-height: 1.5;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .lead__foot {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 0.25rem;
    }

    .lead__cta {
      justify-content: center;
    }

    .lead__ticks {
      gap: 0 4px;
      justify-content: center;
    }

    .tick {
      flex: 0 0 1.5rem;
      inline-size: auto;
    }

    .showcase__list {
      margin-block-start: 0.875rem;
      border-block-end: 0;
    }

    .work-row {
      position: relative;
    }

    /* Room at the start for the thumbnail, laid over it. */
    .work-row__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.875rem;
      padding-block: 0.5rem;
      padding-inline-start: 4.875rem;
    }

    .work-row__link::before,
    .work-row__group,
    .work-row__year,
    .work-row__arrow {
      display: none;
    }

    .work-row__index {
      grid-column: 2;
      grid-row: 1;
      font-size: 0.75rem;
    }

    .work-row__title {
      overflow: hidden;
      font-size: 1rem;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .work-row__meta {
      display: block;
      font-size: 0.6875rem;
    }

    /* The cover as the row's thumbnail. */
    .showcase :global(.work-row__thumb) {
      inset-block-start: 50%;
      inline-size: 4rem;
      border: var(--hairline);
      border-radius: var(--radius-s);
      box-shadow: none;
      opacity: 1;
      translate: 0 -50%;
    }

    .work-row[data-on] :global(.work-row__thumb) {
      border-color: var(--accent);
    }
  }
</style>
