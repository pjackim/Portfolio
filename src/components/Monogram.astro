---
/**
 * "pj" monogram with an accent cursor block (spec-design-content §2, §3). Decorative: the
 * surrounding link carries the accessible name. Geometry lives in `src/lib/monogram.ts` (shared
 * with the favicon and OG card); at the default size (18px tall) every stem lands on whole
 * pixels. The x-height band is vertically centred in the box, so `align-items: center` next to
 * Geist caps lines the bowl up with the cap height.
 *
 * Caret (interactions spec §2): with `.is-blinking` (added by SiteHeader's script on the first
 * page load of a session only) the accent block blinks like a terminal caret — hard steps,
 * five 1 s cycles — then stays solid. Behind the motion gate.
 */
import { MONOGRAM } from '../lib/monogram';

interface Props {
  /** Rendered height in CSS px; width follows the 22:18 grid. */
  size?: number;
  class?: string;
}

const { size = 18, class: className } = Astro.props;
const width = Math.round((size * MONOGRAM.width) / MONOGRAM.height);
const { cursor } = MONOGRAM;
---

<svg
  class:list={['monogram', className]}
  viewBox={`0 0 ${MONOGRAM.width} ${MONOGRAM.height}`}
  width={width}
  height={size}
  aria-hidden="true"
  focusable="false"
>
  <g fill="none" stroke="currentColor" stroke-width={MONOGRAM.strokeWidth}>
    {MONOGRAM.strokes.map((d) => (
      <path d={d} />
    ))}
  </g>
  {MONOGRAM.rects.map((r) => (
    <rect x={r.x} y={r.y} width={r.width} height={r.height} fill="currentColor" />
  ))}
  <rect
    class="monogram__cursor"
    x={cursor.x}
    y={cursor.y}
    width={cursor.width}
    height={cursor.height}
  />
</svg>

<style>
  .monogram {
    flex: none;
    inline-size: auto;
    overflow: visible;
  }

  .monogram__cursor {
    fill: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes monogram-caret {
      50% {
        opacity: 0;
      }
    }

    :global(:root:not([data-motion='off'])) .monogram.is-blinking .monogram__cursor {
      animation: monogram-caret 1s steps(1, end) 5;
    }
  }
</style>
