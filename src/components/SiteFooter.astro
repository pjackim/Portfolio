---
/**
 * Site footer (spec-design-content §2, §3): one row under a hairline — the copyright readout at
 * the start and the Motion toggle chip at the end, the site-wide motion control on pages
 * without the hero (interactions spec §1). On narrow phones the chip drops below the copyright,
 * at the start. The year is the build's (src/lib/build-info.ts: from the commit, not the wall
 * clock, so a rebuild is byte-identical).
 */
import { site } from '../data/site';
import { buildYear } from '../lib/build-info';
import MotionToggle from './MotionToggle.astro';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="mono-label">
      © {buildYear}
      {site.name}
    </p>
    <MotionToggle class="site-footer__motion" deferLayer />
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-m) var(--space-l);
    border-block-start: var(--hairline);
  }

  /* Copyright and Motion chip on one line, the chip at the end. The chip's slot is its widest
     state's box from first paint (MotionToggle), so the row never re-flows as it appears. */
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
  }

  /* Narrow phones: stacked, both at the start. The row needs ~24.5rem (the copyright, the
     chip's widest slot and the gap), which a 28rem viewport holds inside its gutters. */
  @media (width < 28rem) {
    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer__inner > :global(.site-footer__motion) {
      justify-items: start;
    }
  }
</style>
