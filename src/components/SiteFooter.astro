---
/**
 * Site footer (spec-design-content §2, §3; Portfolio.dc.html): one row under a hairline — the
 * monogram and copyright readout at the start; at the end the Motion toggle chip, the site-wide
 * motion control on pages without the hero (interactions spec §1), and a back-to-top link. On
 * phones the end drops below the copyright, at the start. The year is the build's (src/lib/build-info.ts: from the commit, not the wall
 * clock, so a rebuild is byte-identical).
 */
import { site } from '../data/site';
import { buildYear } from '../lib/build-info';
import Monogram from './Monogram.astro';
import MotionToggle from './MotionToggle.astro';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__mark mono-label">
      <Monogram size={17} />
      <span>
        © {buildYear} {site.name}
      </span>
    </p>
    <div class="site-footer__end">
      <MotionToggle class="site-footer__motion" deferLayer />
      <a class="site-footer__top mono-label" href="#main">
        Back to top ↑
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-m) var(--space-l);
    border-block-start: var(--hairline);
  }

  /* Copyright and Motion chip on one line, the chip at the end. The chip's slot is its widest
     state's box from first paint (MotionToggle), so the row never re-flows as it appears. */
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-l);
  }

  .site-footer__mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .site-footer__mark :global(.monogram) {
    color: var(--text);
  }

  .site-footer__end {
    display: flex;
    align-items: center;
    gap: var(--space-2xs) var(--space-m);
  }

  .site-footer__top {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .site-footer__top:hover {
      color: var(--text);
    }
  }

  /* Phones: stacked, both at the start. The row needs ~33rem (the copyright, the chip's
     widest slot, the back-to-top link and the gaps), which a 40rem viewport holds inside its
     gutters.
     Each row is pinned to a set height (a floor: text zoom still grows it), so the footer's
     height is a known sum of its own spacing, `--footer-h`: hairline + padding-block + the two
     rows and the gap between them. The phone home page sizes its last screen with it
     (HomeMobilePanels.astro: Contact + footer = the screen under the header). */
  @media (width < 40rem) {
    :global(:root) {
      --footer-mark-h: 1.125rem;
      --footer-end-h: 2.75rem;
      --footer-h: calc(
        1px + var(--space-m) + var(--space-l) + var(--footer-mark-h) + var(--space-xs) +
          var(--footer-end-h)
      );
    }

    .site-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-footer__mark {
      min-block-size: var(--footer-mark-h);
    }

    /* The chip at the start of its slot, and the link at the far end (not after the slot's
       spare width). */
    .site-footer__end {
      align-self: stretch;
      justify-content: space-between;
      min-block-size: var(--footer-end-h);
    }

    .site-footer__end > :global(.site-footer__motion) {
      justify-items: start;
    }
  }
</style>
