---
/**
 * The brand mark (docs/identity/brand.md): a paper-fold "P" in near-white with an orange "J" in
 * its counter, drawn bare on a transparent background so it sits on whatever ground the page has.
 * Decorative: the surrounding link carries the accessible name.
 *
 * The image is `logo-mark.webp`, the master (`logo.png`) cropped to its shape; `npm run og`
 * rebuilds it, and astro:assets serves it at the sizes below. The box's side is `--logo-size`
 * (set by the caller's stylesheet, default 2rem); the mark fills its height. `eager` for the
 * header's, which is on screen at first paint; the footer's loads lazily.
 */
import { Image } from 'astro:assets';
import mark from '../assets/brand/logo-mark.webp';

interface Props {
  class?: string;
  eager?: boolean;
}

const { class: className, eager = false } = Astro.props;
---

<span class:list={['logo', className]}>
  <Image
    src={mark}
    format="webp"
    widths={[20, 40, 60]}
    sizes="20px"
    alt=""
    class="logo__mark"
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
</span>

<style>
  .logo {
    display: inline-grid;
    flex: none;
    place-items: center;
    inline-size: var(--logo-size, 2rem);
    block-size: var(--logo-size, 2rem);
  }

  .logo :global(.logo__mark) {
    inline-size: auto;
    block-size: 100%;
  }
</style>
