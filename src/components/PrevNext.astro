---
/**
 * Case-study footer navigation (spec-design-content §2, §3): "← PREVIOUS / title" and
 * "NEXT → / title" — featured projects step by `order`, archive projects by year
 * (`getPrevNext`). A missing side is simply left out; Next stays in the right-hand cell.
 * Whole cells are the targets; links are hover-prefetched (Ruling R24).
 */
import type { Project } from '../lib/projects';
import { withBase } from '../lib/url';
import Arrow from './Arrow.astro';

interface Props {
  prev?: Project | undefined;
  next?: Project | undefined;
  class?: string;
}

const { prev, next, class: className } = Astro.props;
const href = (project: Project) => withBase(`work/${project.id}/`);
---

{(prev || next) && (
  <nav class:list={['prev-next', className]} aria-label="More projects">
    {prev && (
      <a class="prev-next__link prev-next__link--prev" href={href(prev)} data-astro-prefetch>
        <span class="prev-next__label mono-label">
          <Arrow dir="left" />
          Previous
        </span>
        <span class="prev-next__title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a class="prev-next__link prev-next__link--next" href={href(next)} data-astro-prefetch>
        <span class="prev-next__label mono-label">
          Next
          <Arrow />
        </span>
        <span class="prev-next__title">{next.data.title}</span>
      </a>
    )}
  </nav>
)}

<style>
  .prev-next {
    display: grid;
    border-block: var(--hairline);
  }

  .prev-next__link {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding-block: var(--space-m);
    color: var(--text);
    text-decoration: none;
  }

  .prev-next__link + .prev-next__link {
    border-block-start: var(--hairline);
  }

  /* Hover wash, bled past the text edge like the archive rows. */
  .prev-next__link::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(-1 * var(--space-xs));
    background-color: var(--surface);
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-standard);
  }

  .prev-next__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }

  .prev-next__title {
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .prev-next__link:focus-visible::before {
    opacity: 1;
  }

  .prev-next__link:focus-visible .prev-next__title {
    color: var(--accent);
  }

  @media (hover: hover) {
    .prev-next__link:hover::before {
      opacity: 1;
    }

    .prev-next__link:hover .prev-next__title {
      color: var(--accent);
    }
  }

  /* Wide: two cells split by a vertical hairline; Next is right-aligned in the right cell. */
  @media (width >= 40rem) {
    .prev-next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .prev-next__link--prev {
      padding-inline-end: var(--space-l);
    }

    .prev-next__link--next {
      grid-column: 2;
      justify-items: end;
      padding-inline-start: var(--space-l);
      border-inline-start: var(--hairline);
      text-align: end;
    }

    .prev-next__link + .prev-next__link {
      border-block-start: 0;
    }

    .prev-next__link--prev::before {
      inset-inline-end: 0;
    }

    .prev-next__link--next::before {
      inset-inline-start: 0;
    }
  }

  /* Motion (the gate, global.css): the arrow nudges toward where it points. */
  @media (prefers-reduced-motion: no-preference) {
    :global(:root:not([data-motion='off'])) .prev-next__label :global(.arrow) {
      transition: translate var(--dur-base) var(--ease-out);
    }

    :global(:root:not([data-motion='off'])) .prev-next__link--prev:focus-visible :global(.arrow) {
      translate: -2px 0;
    }

    :global(:root:not([data-motion='off'])) .prev-next__link--next:focus-visible :global(.arrow) {
      translate: 2px 0;
    }

    @media (hover: hover) {
      :global(:root:not([data-motion='off'])) .prev-next__link--prev:hover :global(.arrow) {
        translate: -2px 0;
      }

      :global(:root:not([data-motion='off'])) .prev-next__link--next:hover :global(.arrow) {
        translate: 2px 0;
      }
    }
  }
</style>
