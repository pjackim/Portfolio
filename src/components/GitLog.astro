---
/**
 * Experience as a git log (design/git-log-rework, Sept 2026; successor to Portfolio.dc.html's
 * log): `site.experience`, newest first, one commit per role or milestone on the main line. Each
 * skill family is a long-lived branch beside main that merges into every milestone that used it;
 * the skills still being learned are unmerged commits on their branch, above HEAD. Open a
 * milestone and its skills appear under it, nested, as its branches' commits. Chips `--grep` a
 * family: its milestones open, its lane lights, the rest dims.
 *
 * The graph is drawn here, one SVG slice per row (src/lib/git-log.ts): the lanes don't depend on
 * what's open, so src/scripts/git-log.ts only toggles state. Slices fill their rows, so rows wrap
 * freely at any width, phones included. Without JS the default state stays (HEAD open) and the
 * controls, which would do nothing, are not shown.
 */
import { site, LOG_FAMILIES, type LogCommit } from '../data/site';
import { layoutLog, logCommand, mergedSkills, tipSkills } from '../lib/git-log';
import MotionLayer from './MotionLayer.astro';

interface Props {
  class?: string;
  /** Prefix for the skill lists' ids, so a page can render two logs (home: desktop + phone). */
  idPrefix?: string;
}

const { class: className, idPrefix = 'gl' } = Astro.props;
const commits: readonly LogCommit[] = site.experience;
const layout = layoutLog(commits, LOG_FAMILIES);
const tips = tipSkills(commits);
const plural = (n: number) => `${n} ${n === 1 ? 'skill' : 'skills'}`;
---

<div class:list={['git-log', className]} data-git-log>
  <div class="git-log__bar">
    <p class="git-log__cmd">
      <span class="git-log__prompt" aria-hidden="true">
        $
      </span>
      <span data-git-cmd>{logCommand(null)}</span>
    </p>
    <div class="git-log__chips" role="group" aria-label="Show one skill family">
      {['', ...LOG_FAMILIES].map((family) => (
        <button
          type="button"
          class:list={['git-log__chip', family && `gl-f-${family}`]}
          data-grep={family}
          aria-pressed={family === '' ? 'true' : 'false'}
        >
          {family && <span class="git-log__chip-dot" aria-hidden="true" />}
          {family || 'all'}
        </button>
      ))}
    </div>
  </div>
  <p class="git-log__note" data-git-note aria-live="polite">
    Each lane is a skill family, merged into the milestones that used it. Open a milestone to see
    its skills.
  </p>
  <p class="git-log__legend" aria-hidden="true">
    <span>
      <span class="git-log__key git-log__key--fill"></span>skill
    </span>
    <span>
      <span class="git-log__key"></span>
      <span class="git-log__key git-log__key--dash"></span>
      learning, not merged yet
    </span>
  </p>

  <div class="git-log__frame" data-reveal>
    <ol class="git-log__list" role="list">
      {tips.map((s, j) => (
        <li
          class={`git-log__row skill skill--tip gl-f-${s.family}`}
          data-skill
          data-tip
          data-family={s.family}
          data-learning
          data-fams={layout.tips[j]?.fams}
          data-lane={layout.tips[j]?.lane}
        >
          <span class="git-log__when" />
          <span class="git-log__gutter" aria-hidden="true" set:html={layout.tips[j]?.svg} />
          <span class="skill__name">
            {s.name}
            <span class="skill__learning">learning</span>
          </span>
          <span class="skill__family">{s.family}</span>
        </li>
      ))}
      {commits.map((c, i) => {
        const g = layout.commits[i];
        const skills = mergedSkills(c);
        return (
          <li
            class:list={['commit', i === 0 && 'commit--head']}
            data-commit={c.id}
            data-title={c.title}
            data-fams={g?.row.fams}
            data-open={(i === 0 && skills.length > 0) || undefined}
          >
            <div class="git-log__row commit__row">
              <span class="git-log__when">{c.when}</span>
              <span class="git-log__gutter" aria-hidden="true" set:html={g?.row.svg} />
              <p class="commit__line">
                {c.when && <span class="commit__when">{c.when}</span>}
                {i === 0 && <span class="commit__badge">HEAD → main</span>}
                <span class="commit__title">{c.title}</span>
                <span class="commit__org">
                  <span class="commit__sep" aria-hidden="true">
                    {' · '}
                  </span>
                  <span class="visually-hidden">, </span>
                  {c.org}
                </span>
                {c.meta && <span class="commit__meta">{c.meta}</span>}
              </p>
              {skills.length > 0 && (
                <button
                  type="button"
                  class="commit__toggle"
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`${idPrefix}-${c.id}-skills`}
                >
                  <span class="commit__count" aria-hidden="true">
                    {skills.length}
                    <span class="commit__count-word">
                      {skills.length === 1 ? ' skill' : ' skills'}
                    </span>
                  </span>
                  <span class="commit__chev" aria-hidden="true" />
                  <span class="visually-hidden">
                    {plural(skills.length)} from {c.title}
                  </span>
                </button>
              )}
            </div>
            {skills.length > 0 && (
              <ul class="commit__skills" id={`${idPrefix}-${c.id}-skills`} role="list">
                {skills.map((s, j) => (
                  <li
                    class={`git-log__row skill gl-f-${s.family}`}
                    data-skill
                    data-family={s.family}
                    data-fams={g?.skills[j]?.fams}
                    data-lane={g?.skills[j]?.lane}
                  >
                    <span class="git-log__when" />
                    <span class="git-log__gutter" aria-hidden="true" set:html={g?.skills[j]?.svg} />
                    <span class="skill__name">{s.name}</span>
                    <span class="skill__family">{s.family}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
      <li class="git-log__row git-log__init" aria-hidden="true">
        <span class="git-log__when"></span>
        <span class="git-log__gutter" set:html={layout.init.svg} />
        <span class="git-log__init-label">init</span>
      </li>
    </ol>
  </div>
</div>
<MotionLayer />

<style>
  /* Family colours: set on the element, read by its own strokes, fills and text. Global inside
     the log: the graph's markup is set as HTML, so it carries no scope attribute. */
  .git-log :global(.gl-f-security) {
    --gl-c: var(--family-security);
  }

  .git-log :global(.gl-f-software) {
    --gl-c: var(--family-software);
  }

  .git-log :global(.gl-f-teaching) {
    --gl-c: var(--family-teaching);
  }

  .git-log :global(.gl-f-design) {
    --gl-c: var(--family-design);
  }

  /* The picked (or previewed) family's colour, for the highlight bands. */
  .git-log[data-pick='security'] {
    --gl-pick: var(--family-security);
  }

  .git-log[data-pick='software'] {
    --gl-pick: var(--family-software);
  }

  .git-log[data-pick='teaching'] {
    --gl-pick: var(--family-teaching);
  }

  .git-log[data-pick='design'] {
    --gl-pick: var(--family-design);
  }

  .git-log :global(.gl-f-main) {
    --gl-c: var(--family-main);
  }

  /* Geometry shared with src/lib/git-log.ts: graphWidth(4) and NODE_Y (literal here:
     `define:vars` would write a style attribute, which the CSP forbids). */
  /* The log stops short of a wide container, so a toggle stays in reach of its title and the
     chips line up with the rows' end. */
  .git-log {
    max-inline-size: 56rem;
    --gl-w: 80px;
    --gl-when: 4.75rem;
    --gl-gap: 0.875rem;
    /* The nested skills' indent (plus a step per lane between the skill's and main, so a list
       staggers like the graph beside it), where their tree's spine runs inside it, and the box
       the corner into the last skill is drawn in (the curve plus the 1px above it). */
    --gl-indent: 1.625rem;
    --gl-lane-step: 0.5rem;
    --gl-tree-x: 0.4375rem;
    --gl-tree: 1px solid var(--line-ui);
    --gl-corner: calc(var(--radius-s) + 1px);
    /* Where a row's highlight band starts: just short of the text column. */
    --gl-band-x: calc(var(--gl-when) + var(--gl-w) + 2 * var(--gl-gap) - 0.5rem);
  }

  /* ── Command line, chips, note ── */

  .git-log__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs) var(--space-m);
  }

  .git-log__cmd {
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .git-log__prompt {
    color: var(--accent);
  }

  .git-log__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .git-log__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.125rem;
    padding-inline: 0.75rem;
    border: var(--hairline);
    border-radius: var(--radius-xs);
    background-color: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .git-log__chip-dot {
    inline-size: 7px;
    block-size: 7px;
    border-radius: 50%;
    background-color: var(--gl-c);
  }

  @media (hover: hover) {
    .git-log__chip:hover {
      border-color: var(--line-ui);
      color: var(--text);
    }
  }

  .git-log__chip[aria-pressed='true'] {
    border-color: var(--gl-c, var(--line-ui));
    background-color: var(--surface-2);
    color: var(--text);
  }

  .git-log__note {
    max-inline-size: var(--measure);
    margin-block-start: var(--space-xs);
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .git-log__note :global(b) {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .git-log__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) 1.25rem;
    margin-block-start: var(--space-3xs);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .git-log__legend > span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .git-log__key {
    box-sizing: border-box;
    inline-size: 8px;
    block-size: 8px;
    border: 1.5px solid var(--text-muted);
    border-radius: 50%;
  }

  .git-log__key--fill {
    background-color: var(--text-muted);
  }

  .git-log__key--dash {
    inline-size: 16px;
    block-size: 0;
    border: 0;
    border-block-start: 1.5px dashed var(--text-muted);
    border-radius: 0;
  }

  /* The controls need the script; without it the default view stays, with nothing to press. */
  @media (scripting: none) {
    .git-log__chips,
    .commit__toggle {
      visibility: hidden;
    }
  }

  /* ── The log ── */

  .git-log__frame {
    margin-block-start: var(--space-s);

    /* Entrance (reveal.ts): the log wipes down from the top. */
    --reveal-x: 0;
    --reveal-y: 0;
    --reveal-clip: inset(0 0 100% 0);
    --reveal-dur: 900ms;
  }

  .git-log__list,
  .commit__skills {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Every row: date, its slice of the graph, text, and an end column. Rows touch (no margins),
     so each slice meets the next. `--y` is the row's node line (NODE_Y). */
  .git-log__row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: var(--gl-when) var(--gl-w) minmax(0, 1fr) auto;
    column-gap: var(--gl-gap);
    align-items: start;
  }

  .commit__row {
    --y: 24px;

    min-block-size: 48px;
  }

  .skill,
  .git-log__init {
    --y: 18px;

    min-block-size: 36px;
  }

  .git-log__gutter {
    position: relative;
    align-self: stretch;
  }

  .git-log__gutter :global(.gl-svg) {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    block-size: 100%;
    overflow: visible;
  }

  .git-log__gutter :global(.gl-line) {
    fill: none;
    stroke: var(--gl-c);
    stroke-width: 1.6;
  }

  .git-log__gutter :global(.gl-line--dash) {
    stroke-dasharray: 2 4;
  }

  .git-log__gutter :global(.gl-gap) {
    stroke: var(--bg);
    stroke-width: 5;
  }

  .git-log__gutter :global(.gl-node) {
    fill: var(--bg);
    stroke: var(--gl-c);
    stroke-width: 1.6;
  }

  .git-log__gutter :global(.gl-node--fill) {
    fill: var(--gl-c);
  }

  .git-log__gutter :global(.gl-halo) {
    fill: none;
    stroke: var(--gl-c);
    stroke-width: 1.2;
    opacity: 0.35;
  }

  .git-log__gutter :global(.gl-line[data-hit]) {
    stroke-width: 2.4;
  }

  .git-log__gutter :global([data-dim]) {
    opacity: 0.16;
  }

  .git-log__when {
    padding-block-start: calc(var(--y) - 7.5px);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.78125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 15px;
    text-align: end;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .commit--head .git-log__when {
    color: var(--text);
  }

  /* A pick's rows: a faint band in its colour, like a selected commit. */
  .git-log__row::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: 0;
    inset-inline: var(--gl-band-x) 0;
    border-radius: var(--radius-xs);
  }

  .commit[data-hit] > .commit__row::before,
  .skill[data-hit]::before {
    background-color: color-mix(in oklab, var(--gl-pick) 9%, transparent);
  }

  /* A dimmed milestone's toggle still works, so only its label dims: its focus ring stays full. */
  .commit[data-dim] > .commit__row > :not(.git-log__gutter, .commit__toggle),
  .commit[data-dim] > .commit__row > .commit__toggle > *,
  .skill[data-dim] > :not(.git-log__gutter) {
    opacity: 0.35;
  }

  /* ── Milestones ── */

  /* Stretched to the row's height (so the tree line below it meets the first skill), its
     content kept on the node line. */
  .commit__line {
    display: flex;
    flex-wrap: wrap;
    align-self: stretch;
    align-content: flex-start;
    align-items: baseline;
    gap: 0 0.625rem;
    min-inline-size: 0;
    padding-block: calc(var(--y) - 11.5px) 0.75rem;
  }

  .commit__when {
    display: none;
  }

  .commit__badge {
    align-self: center;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-xs);
    background-color: var(--text);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .commit__title,
  .commit__org {
    font-size: 1.0625rem;
    line-height: 23px;
  }

  .commit__title {
    font-weight: 500;
  }

  .commit__org {
    color: var(--text-muted);
  }

  .commit__meta,
  .commit__when {
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .commit__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    block-size: 1.75rem;
    margin-block-start: calc(var(--y) - 14px);
    padding-inline: 0.625rem;
    border: var(--rule-ui);
    border-radius: var(--radius-xs);
    background-color: transparent;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* The whole row is the toggle's target. */
  .commit__toggle::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-xs);
  }

  .commit__toggle:focus-visible {
    outline: none;
  }

  .commit__toggle:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .commit__chev {
    inline-size: 6px;
    block-size: 6px;
    margin-block-start: -3px;
    border-inline-end: 1.5px solid currentColor;
    border-block-end: 1.5px solid currentColor;
    rotate: 45deg;
  }

  .commit__toggle[aria-expanded='true'] {
    border-color: var(--line-ui);
    color: var(--text);
  }

  .commit__toggle[aria-expanded='true'] .commit__chev {
    margin-block: 3px 0;
    rotate: -135deg;
  }

  @media (hover: hover) {
    .commit__row:has(.commit__toggle:hover)::before {
      background-color: var(--surface-2);
    }

    .commit__row:has(.commit__toggle:hover) .commit__toggle {
      border-color: var(--line-ui);
      color: var(--text);
    }

    .commit[data-hit] > .commit__row:has(.commit__toggle:hover)::before {
      background-color: color-mix(in oklab, var(--gl-pick) 14%, transparent);
    }
  }

  .commit:not([data-open]) > .commit__skills {
    display: none;
  }

  /* ── Skills: nested under their milestone, on a hairline tree ── */

  /* A skill's indent grows with its lane (data-lane, src/lib/git-log.ts: 1 is the lane next to
     main), one rule per family lane like the colours above. */
  .skill {
    --gl-lane: 1;
    --gl-in: calc(var(--gl-indent) + (var(--gl-lane) - 1) * var(--gl-lane-step));
  }

  .skill[data-lane='2'] {
    --gl-lane: 2;
  }

  .skill[data-lane='3'] {
    --gl-lane: 3;
  }

  .skill[data-lane='4'] {
    --gl-lane: 4;
  }

  .skill__name {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-self: stretch;
    align-content: flex-start;
    align-items: center;
    gap: 0 0.5rem;
    min-inline-size: 0;
    padding-block: calc(var(--y) - 10.5px) 0.3125rem;
    padding-inline-start: var(--gl-in);
    color: var(--text-muted);
    font-size: 0.9375rem;
    line-height: 21px;
  }

  /* The tree: a spine from under the milestone's title (main, so neutral), a tick into each
     skill in its family's colour, and into the last a rounded corner that curves off the spine
     in that colour, like a lane's join in the graph. The tips above HEAD belong to no
     milestone: indented, no tree. */
  .commit__line {
    position: relative;
  }

  .commit[data-open] > .commit__row > .commit__line::after,
  .commit__skills .skill__name::before,
  .commit__skills .skill__name::after {
    content: '';
    position: absolute;
    inset-inline-start: var(--gl-tree-x);
  }

  .commit[data-open] > .commit__row > .commit__line::after {
    inset-block-end: 0;
    block-size: calc(0.75rem - 4px);
    border-inline-start: var(--gl-tree);
  }

  .commit__skills .skill__name::before {
    inset-block: 0;
    border-inline-start: var(--gl-tree);
  }

  .commit__skills .skill__name::after {
    inset-block-start: calc(var(--y) - 0.5px);
    inline-size: calc(var(--gl-in) - var(--gl-tree-x) - 0.375rem);
    border-block-start: 1px solid var(--gl-c);
  }

  /* The last skill: the spine runs 1px into the corner box (no seam), which takes over from
     there in the family's colour. */
  .commit__skills .skill:last-child .skill__name::before {
    inset-block-end: auto;
    block-size: calc(var(--y) + 1.5px - var(--gl-corner));
  }

  .commit__skills .skill:last-child .skill__name::after {
    inset-block-start: calc(var(--y) + 0.5px - var(--gl-corner));
    block-size: var(--gl-corner);
    border-block-start: 0;
    border-block-end: 1px solid var(--gl-c);
    border-inline-start: 1px solid var(--gl-c);
    border-end-start-radius: var(--radius-s);
  }

  .skill__learning {
    padding: 0 0.4375rem;
    border: 1px dashed var(--gl-c);
    border-radius: var(--radius-xs);
    color: var(--gl-c);
    font-family: var(--font-mono);
    font-size: 0.71875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.5;
  }

  .skill__family {
    margin-block-start: calc(var(--y) - 8px);
    color: var(--gl-c);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 16px;
  }

  .git-log__init-label {
    padding-block-start: calc(var(--y) - 10.5px);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 21px;
  }

  /* ── Motion (the gate, global.css) ── */
  @media (prefers-reduced-motion: no-preference) {
    @keyframes gl-skill-in {
      from {
        opacity: 0;
        translate: 0 -4px;
      }
    }

    /* Only a milestone just opened (`data-fresh`, git-log.ts): never one open on load. */
    :global(:root:not([data-motion='off'])) .commit[data-fresh] > .commit__skills > .skill {
      animation: gl-skill-in 240ms var(--ease-out) backwards;
    }

    :global(:root:not([data-motion='off']))
      .commit[data-fresh]
      > .commit__skills
      > .skill:nth-child(2) {
      animation-delay: 40ms;
    }

    :global(:root:not([data-motion='off']))
      .commit[data-fresh]
      > .commit__skills
      > .skill:nth-child(n + 3) {
      animation-delay: 80ms;
    }

    :global(:root:not([data-motion='off'])) .git-log__row > :not(.git-log__gutter),
