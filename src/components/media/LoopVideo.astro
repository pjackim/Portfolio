---
/**
 * Silent screen-recording video (spec-design-content §3). Server-rendered with native
 * `controls` and `preload="none"`, so it works without JS and costs nothing until played.
 * `src/scripts/video.ts` replaces the controls with a visible Pause / Play toggle, and the
 * `autoplay` loops play only while on screen (never under reduced motion or Save-Data; on a
 * slow connection only once the page's images are upgraded). Click-to-play videos don't loop and
 * start only from the toggle. A click on the picture itself, on either kind, opens a playing
 * copy with the native controls in the project's lightbox (src/scripts/lightbox.ts).
 * The poster is a lazy, adaptive `<picture>` (AVIF / WebP, srcset) laid under the `<video>`, so
 * it gets the same quality-first delivery as every other image, and the lite path on a slow
 * connection. The `<video>` keeps a `poster` attribute that is one transparent pixel: with none,
 * Chromium paints a video that has no frame yet as an opaque dark box and WebKit as a light
 * veil, over the picture, with or without JS and with or without `controls`; with a transparent
 * one the picture shows through until the first frame (measured in both engines).
 * Width/height (and the aspect ratio) come from the poster file, so nothing shifts on load.
 */
import { Picture } from 'astro:assets';
import { adaptive, candidateWidths, imageFacts, scalableSizes } from '../../lib/images';
import { videoSources } from '../../lib/media';
import { pageStyle } from '../../lib/page-style';

interface Props {
  projectId: string;
  /** Frontmatter `./<name>.mp4`; `.webm` and `.poster.webp` siblings by convention. */
  src: string;
  /** Accessible name of the video. */
  alt: string;
  autoplay: boolean;
  /** `sizes` for the poster picture, matching the column the figure sits in. */
  sizes: string;
}

/** A 1×1 transparent GIF: the video's own poster, so it is see-through (`img-src` allows data:). */
const NO_POSTER = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==';

const { projectId, src, alt, autoplay, sizes } = Astro.props;
const { mp4, webm, poster } = videoSources(projectId, src);
const { width, height } = await imageFacts(poster);
const style = pageStyle(Astro.locals, { 'aspect-ratio': `${width} / ${height}` });
---

<div class="loop-video" data-video data-autoplay={autoplay || undefined}>
  <Picture
    src={poster}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={candidateWidths(width, 1826)}
    sizes={scalableSizes(sizes)}
    alt=""
    class="loop-video__poster"
    {...adaptive()}
  />
  <video
    muted
    loop={autoplay}
    playsinline
    preload="none"
    poster={NO_POSTER}
    controls
    aria-label={alt}
    width={width}
    height={height}
    data-style={style}
  >
    <source src={webm} type='video/webm; codecs="vp9"' />
    <source src={mp4} type="video/mp4" />
  </video>
</div>

<script src="../../scripts/video.ts"></script>

<style>
  /* The poster picture and the video share one cell: the video (later in the source, so on top)
     has no background and a transparent poster, so the picture shows through until it has a
     frame. The figure frame centres its child, so the width is set here, never left to the
     content: an unloaded poster and a video with no metadata size to nothing. */
  .loop-video {
    position: relative;
    display: grid;
    inline-size: 100%;
    background-color: var(--surface-2);
  }

  .loop-video :global(picture) {
    display: contents;
  }

  .loop-video :global(.loop-video__poster),
  video {
    grid-area: 1 / 1;
  }

  .loop-video :global(.loop-video__poster) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  video[data-zoomable] {
    cursor: zoom-in;
  }

  video {
    inline-size: 100%;
    block-size: auto;
  }

  /* A focused click-to-play video (native controls, which it keeps with no script): the figure
     frame's overflow clips the video's own ring, so the ring is drawn inside it, on a page-colour
     halo that keeps it legible over any footage (as the card reticle's). */
  .loop-video:has(> video:focus-visible)::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 2px solid var(--accent);
    box-shadow: inset 0 0 0 2px var(--bg);
    pointer-events: none;
  }

  @media (forced-colors: active) {
    .loop-video:has(> video:focus-visible)::after {
      border-color: Highlight;
    }
  }

  /* Toggle added by the script (no scoping attribute): a frosted mono chip in the bottom-right
     corner, 44px tall, same family as the YouTube facade's play chip. A fixed dark glass keeps
     the label legible over any footage in either theme; the accent icon marks it as a control. */
  .loop-video :global(.video-toggle) {
    position: absolute;
    inset-block-end: var(--space-xs);
    inset-inline-end: var(--space-xs);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-inline: 0.75rem 0.875rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 999px;
    background-color: rgb(12 14 18 / 0.62);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    backdrop-filter: blur(10px) saturate(1.4);
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.35);
    color: #f4f5f7;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      color var(--dur-fast) var(--ease-standard),
      background-color var(--dur-fast) var(--ease-standard),
      border-color var(--dur-fast) var(--ease-standard),
      transform var(--dur-fast) var(--ease-out);
  }

  .loop-video :global(.video-toggle:active) {
    transform: scale(0.96);
  }

  .loop-video :global(.video-toggle__icon) {
    inline-size: 0.875rem;
    block-size: 0.875rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    color: var(--accent);
    transition: color var(--dur-fast) var(--ease-standard);
  }

  .loop-video :global(.video-toggle__play) {
    fill: currentColor;
    stroke: none;
  }

  .loop-video :global(.video-toggle[data-state='playing'] .video-toggle__play),
  .loop-video :global(.video-toggle[data-state='paused'] .video-toggle__pause) {
    display: none;
  }

  /* The label has a fixed width, so Pause ⇄ Play never resizes the chip. */
  .loop-video :global(.video-toggle__label) {
    min-inline-size: 5ch;
  }

  /* Keyboard focus fills the chip as hover does (as the YouTube chip): the focus ring alone
     sits on the footage, where no single colour keeps 3:1. */
  .loop-video :global(.video-toggle:focus-visible) {
    border-color: var(--accent);
    background-color: var(--accent);
    color: var(--on-accent);
  }

  .loop-video :global(.video-toggle:is(:focus-visible, :hover) .video-toggle__icon) {
    color: currentColor;
  }

  @media (forced-colors: active) {
    .loop-video :global(.video-toggle) {
      background-color: ButtonFace;
      border-color: ButtonText;
      color: ButtonText;
      backdrop-filter: none;
    }
  }

  @media (hover: hover) {
    .loop-video :global(.video-toggle:hover) {
      border-color: var(--accent);
      background-color: var(--accent);
      color: var(--on-accent);
    }
  }
</style>
